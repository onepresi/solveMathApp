# Copy this file to .env and fill in your values. .env is git-ignored.
#
# Server-only secrets. Read by Expo Router API routes (app/api/*+api.ts).
# Never prefix these with EXPO_PUBLIC_: that would bundle them into the app.
OPENAI_API_KEY=

# Optional overrides
# Model used to read and solve problems. See https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6-astra
# low | medium | high | xhigh | max. Higher is more thorough but slower and costlier.
OPENAI_REASONING_EFFORT=medium
